if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
  message(FATAL_ERROR "The Linux profile targets the local x86-64 Steam ELF only")
endif()
enable_language(ASM)
find_package(OpenSSL REQUIRED COMPONENTS Crypto)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/out")
set(CMAKE_LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/out")
add_compile_options(-Wall -Wextra -Wpedantic -fno-strict-aliasing)
include_directories("${CMAKE_CURRENT_SOURCE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}/sdk")
add_executable(urwcn_launcher src/linux/launcher.cpp src/linux/file_identity.cpp)
target_link_libraries(urwcn_launcher PRIVATE OpenSSL::Crypto)
add_library(urwcn_loader SHARED src/linux/host.cpp src/linux/control.cpp src/linux/elf_module.cpp src/linux/hooks.cpp src/linux/gateway.S src/linux/file_identity.cpp)
set_target_properties(urwcn_loader PROPERTIES PREFIX "" SUFFIX ".dll")
target_link_libraries(urwcn_loader PRIVATE ${CMAKE_DL_LIBS} OpenSSL::Crypto pthread)
foreach(module IN ITEMS catalog semantic layout render)
  file(GLOB_RECURSE module_sources CONFIGURE_DEPENDS "${URWCN_MODULE_SOURCE_ROOT}/modules/${module}/*.cpp")
  add_library(urwcn_${module} MODULE ${module_sources})
endforeach()
add_library(urwcn_main_menu MODULE "${URWCN_MODULE_SOURCE_ROOT}/src/linux/main_menu.cpp")
add_library(urwcn_adapter MODULE "${URWCN_MODULE_SOURCE_ROOT}/src/linux/adapter.cpp"
  "${URWCN_MODULE_SOURCE_ROOT}/src/linux/native_targets.cpp" "${URWCN_MODULE_SOURCE_ROOT}/src/linux/redraw.S"
  "${URWCN_MODULE_SOURCE_ROOT}/modules/adapter/scoped_api.cpp" "${URWCN_MODULE_SOURCE_ROOT}/modules/adapter/native_raster.cpp")
foreach(module IN ITEMS catalog semantic layout render main_menu adapter)
  target_include_directories(urwcn_${module} BEFORE PRIVATE "${URWCN_MODULE_SOURCE_ROOT}" "${URWCN_MODULE_SOURCE_ROOT}/sdk")
  set_target_properties(urwcn_${module} PROPERTIES PREFIX "" SUFFIX ".dll")
  target_compile_options(urwcn_${module} PRIVATE $<$<COMPILE_LANGUAGE:CXX>:-fno-gnu-unique> -fvisibility=hidden)
endforeach()
target_link_libraries(urwcn_render PRIVATE ${CMAKE_DL_LIBS} OpenSSL::Crypto)
